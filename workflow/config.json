{
  "schemaVersion": 2,
  "mode": "vibe",
  "modeNote": [
    "vibe   탐색 단계. 마찰을 줄인다.",
    "         - 깨끗한 git 트리를 요구하지 않는다",
    "         - 경로 허용 목록 가드를 끈다 (더러운 트리에서는 사용자 작업과 구분할 수 없으므로 위험)",
    "         - 보호 트리 해시 가드는 유지한다 (git 과 무관하게 동작)",
    "         - proposed / stale 차단을 경고로 낮춘다",
    "         - 추적성 위반을 경고로 낮춘다",
    "         - 디자인을 draft 단일 폴더에 쓴다",
    "strict 안정 단계. 모든 게이트를 켠다.",
    "모듈별로 modules.<모듈>.mode 로 덮어쓸 수 있다."
  ],
  "stack": {
    "preset": "electron-vitest-playwright",
    "note": "workflow/presets.json 의 키 중 하나. init-workspace.ps1 이 채운다."
  },
  "paths": {
    "productCode": [
      "src"
    ],
    "unitTests": "tests/unit",
    "moduleTests": "tests/module",
    "systemTests": "tests/system",
    "systemRequirements": "docs/requirements/system",
    "moduleRequirements": "docs/requirements/modules",
    "traceability": "docs/requirements",
    "design": "docs/design",
    "designAssets": "design-assets",
    "moduleTestReports": "docs/test-reports/module",
    "systemTestReports": "docs/test-reports/system",
    "recheckReports": "docs/test-reports/recheck",
    "prompts": "workflow/prompts",
    "rules": "workflow/rules",
    "temp": "workflow/.tmp",
    "state": "workflow/state.json"
  },
  "commands": {
    "unitTest": "npx vitest run tests/unit",
    "moduleTest": "npx vitest run tests/module/{module} --reporter=junit --outputFile=workflow/.tmp/junit/module-{module}.xml",
    "systemTest": "npx playwright test tests/system --reporter=junit"
  },
  "junit": {
    "moduleTest": "workflow/.tmp/junit/module-{module}.xml",
    "systemTest": "workflow/.tmp/junit/system.xml"
  },
  "codex": {
    "sandbox": "danger-full-access",
    "askForApproval": "never",
    "timeoutSeconds": 1800,
    "preferShim": ".ps1",
    "note": "sandbox 는 read-only / workspace-write / danger-full-access 중 하나. 전권을 주고 경계는 guards 로 지킨다."
  },
  "ids": {
    "systemFunctional": "SYS-FR",
    "systemNonFunctional": "SYS-NFR",
    "systemAcceptance": "SYS-AC",
    "moduleFunctional": "MOD-{MODULE}-FR",
    "moduleNonFunctional": "MOD-{MODULE}-NFR",
    "moduleAcceptance": "MOD-{MODULE}-AC",
    "designFlow": "FLOW",
    "designScreen": "SCREEN",
    "designState": "STATE",
    "designComponent": "COMP",
    "designOpenQuestion": "ODQ",
    "sequenceFormat": "000",
    "note": "{MODULE} 은 대문자 모듈 ID 로 치환된다. 예: MOD-AUTH-FR-001"
  },
  "designSpaces": [
    {
      "key": "workflow",
      "directory": "1-workflow",
      "label": "사용자 워크플로우"
    },
    {
      "key": "wireframe",
      "directory": "2-wireframe",
      "label": "와이어프레임"
    },
    {
      "key": "ui",
      "directory": "3-ui",
      "label": "UI 스펙"
    }
  ],
  "guards": {
    "requireCleanGitTree": true,
    "protectedTrees": [
      "src",
      "tests/unit"
    ],
    "protectedTreesNote": "Claude 소유 영역. Codex 실행 전후 해시를 비교해 gitignore 사각지대까지 침범을 잡는다."
  },
  "stages": {
    "requirements-system": {
      "allow": [
        "{systemRequirements}",
        "{moduleRequirements}"
      ],
      "prompt": "requirements-system.md",
      "reportDirectory": null
    },
    "requirements-module": {
      "allow": [
        "{moduleRequirements}/{module}"
      ],
      "prompt": "requirements-module.md",
      "reportDirectory": null
    },
    "design": {
      "allow": [
        "{design}/{module}",
        "{designAssets}/{module}"
      ],
      "prompt": null,
      "reportDirectory": null
    },
    "test-module": {
      "allow": [
        "{moduleTests}/{module}"
      ],
      "prompt": "test-module.md",
      "reportDirectory": "{moduleTestReports}/{module}"
    },
    "test-system": {
      "allow": [
        "{systemTests}"
      ],
      "prompt": "test-system.md",
      "reportDirectory": "{systemTestReports}"
    },
    "recheck-module": {
      "allow": [
        "{moduleTests}/{module}"
      ],
      "prompt": "recheck.md",
      "reportDirectory": "{recheckReports}"
    },
    "recheck-system": {
      "allow": [
        "{systemTests}"
      ],
      "prompt": "recheck.md",
      "reportDirectory": "{recheckReports}"
    }
  },
  "validation": {
    "minRequirementLength": 400,
    "requiredRequirementMarkers": [
      "## 인수 조건"
    ],
    "minReportLength": 200,
    "note": "Codex 응답을 파일에 쓰기 전 최소 검증. 실패하면 원본을 덮어쓰지 않고 .rejected 로 남긴다."
  },
  "traceability": {
    "idPattern": "(?i)\\b(SYS|MOD)[-_][A-Z0-9_-]*?(FR|NFR|AC)[-_][0-9]{3}\\b",
    "testSourceDirectories": [
      "tests/module",
      "tests/system"
    ],
    "moduleDecompositionHeading": "모듈 분해",
    "output": {
      "json": "docs/requirements/traceability.json",
      "markdown": "docs/requirements/traceability.md"
    },
    "columns": {
      "id": "ID",
      "parent": "상위",
      "implementedBy": "구현 모듈",
      "relatedRequirement": "관련 요구사항",
      "moduleId": "모듈 ID",
      "moduleName": "모듈 이름",
      "responsibility": "책임",
      "coveredSystemRequirements": "담당 시스템 요구사항"
    },
    "note": [
      "표는 헤더 이름으로 열을 찾는다. 위 columns 값과 프롬프트 템플릿의 표 헤더가 일치해야 한다.",
      "ID 는 하이픈과 밑줄 표기를 모두 인식하고 대문자 하이픈 형태로 정규화한다."
    ]
  },
  "statuses": [
    "proposed",
    "confirmed",
    "requirements_ready",
    "design_ready",
    "implemented",
    "verified"
  ]
}